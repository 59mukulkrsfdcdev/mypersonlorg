<aura:component implements ="flexipage:availableForRecordHome,force:hasRecordId"  access="global">
    <aura:attribute name="truthy" default="true" type="boolean" />
    <aura:attribute name="ColorList" type="List" default="['Red','White','Green','Yellow','Black']" />
    <aura:attribute name="mapVar" type="List"/>
    
    
    <div class = "slds-p-around_small">
        <h1 class="red">I am in Lightning Components</h1>
        <p style="background-color:red, color:white;">I am inside Pragraph</p>
        
    </div>
     <aura:if isTrue="{!v.truthy}">
    True
    <aura:set attribute="else">
      False
    </aura:set>
  </aura:if>
    <br/>
    <aura:iteration items= "{!v.ColorList}" var="item">
        {!item} <br/>
        
    </aura:iteration>
    
    <lightning:button label="CreateMap" onclick="{!c.doCreateMap}"/>
    <br/>
    <aura:iteration items ="{!v.mapVar}" var="map">
        key:- {!map.key} value:- {!map.value} <br/>
    </aura:iteration>
    
	
</aura:component>