            margin-top: 30px;
        }
        .chart {
            width:350px;
            // height:300px;
        }
        div{
            
        }
        .containerhead{
            width: 100%;
            height: 22px;
            background-color: beige;
            color: #4353ad;
            font-size: 18px;
            text-align: left;
            padding: 10px;
            font-weight: bold;
        }
        .maincontainerhead{
            width: 100%;
            /* height: 22px; */
            background-color: beige;
            color: #4353ad;
            font-size: 18px;
            text-align: left;
            padding: 10px;
