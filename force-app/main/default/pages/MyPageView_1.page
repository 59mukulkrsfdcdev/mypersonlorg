        <script src="/soap/ajax/43.0/connection.js" type="text/javascript"></script>
        <script src="/soap/ajax/43.0/apex.js" type="text/javascript"></script>
        </head>
        <style>
            
            .maincontainer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                flex-wrap: wrap;
            }
        .container {
            display: flex;
