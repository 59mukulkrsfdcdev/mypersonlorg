                            <script type="text/javascript">
                            
                            // Load the Visualization API and the corechart package.
                            google.charts.load('current', {'packages':['corechart']});
                                               
                                               // Set a callback to run when the Google Visualization API is loaded.
                                               google.charts.setOnLoadCallback(starter);
                                               
                                               // Callback that creates and populates a data table,
                                               // instantiates the pie chart, passes in the data and 
                                               // draws it.
                                               
                                               
                                               function drawColumnChart(i) {
                                var data = google.visualization.arrayToDataTable([
                                    ["Element", "Density", { role: "style" } ],
                                    ["Copper", 8.94, "#b87333"],
                                    ["Silver", 10.49, "silver"],
                                    ["Gold", 19.30, "gold"],
                                    ["Platinum", 21.45, "color: #e5e4e2"]
                                ]);
                                
                                var view = new google.visualization.DataView(data);
                                view.setColumns([0, 1,
                                                 { calc: "stringify",
                                                  sourceColumn: 1,
                                                  type: "string",
                                                  role: "annotation" },
                                                 2]);
                                
                                var options = {
                                    title: "Number of pages by Date ",
                                    width: 400,
                                    bar: {groupWidth: "95%"},
                                    legend: { position: "none" },
                                };
                                console.log("chart_div"+i);
                                var container = document.getElementById("chart_div"+i);
                                console.log(container);
                                var chart = new google.visualization.ColumnChart(container);
                                chart.draw(view, options);
                            }
        function drawDonutChart(i) {
            var data = google.visualization.arrayToDataTable([
                ['Task', 'Hours per Day'],
                ['Work',     11],
                ['Eat',      2],
                ['Commute',  2],
                ['Watch TV', 2],
                ['Sleep',    7]
            ]);
            
            var options = {
                title: 'My Daily Activities',
                pieHole: 0.4,
            };
            var container = document.getElementById("chart_div"+i);
            var chart = new google.visualization.PieChart( container);
            chart.draw(data, options);
        } 
        
        
        
        
        function starter(){
            for(var i=1;i<25;i++){
                if(i % 4 ==  0){
                    drawDonutChart(i) 
                }else{
                    drawColumnChart(i)
                    
                }
            }
        }  
        function fetchUsers() {
            var profileId = document.getElementById("prof");
            console.log(profileId);
           var selectList = document.getElementById(!$Component.prof);
            alert(selectList)
            var selectedValue = selectList.options[selectList.selectedIndex].value;
            alert(selectedValue);
            
            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.PageViewController.fetchUsers}',
                profileId,
                function(result, event) {
                    if (event.status) {
                        var userSelect = document.getElementById("user");
                        userSelect.innerHTML = ''; // Clear existing options
                        for (var i = 0; i < result.length; i++) {
                            var option = document.createElement("option");
                            option.value = result[i].value;
                            option.text = result[i].label;
                            userSelect.add(option);
                        }
                    } else {
                        console.error("Error fetching users: " + event.message);
                    }
                }
            );
        }
        
        function applyFilter() {
            var userId = document.getElementById("user").value;
            var startDate = document.getElementById("startdate").value;
            var endDate = document.getElementById("enddate").value;
            alert(userId+startDate+endDate);
              console.log('Applying filter with User:', userId, 'Start Date:', startDate, 'End Date:', endDate);

            Visualforce.remoting.Manager.invokeAction(
                '{!$RemoteAction.PageViewController.fetchPageViewData}',
                userId,
                new Date(startDate),
                new Date(endDate),
                function(result, event) {
                    if (event.status) {
                        var chartData = [];
                        chartData.push(['Event Date', 'Count', 'Sum Duration', 'Average Duration']);
                        result.forEach(function(row) {
                            chartData.push([new Date(row.date).toLocaleDateString(), row.count, row.sumDuration, row.avgDuration]);
                        });
                        drawLineChart(chartData, 'chart_div1', 'Page Views Summary');
                    } else {
                        console.error("Error fetching page view data: " + event.message);
                    }
                }
            );
        }
        </script>
    </apex:page>